# ---- build output / caches
.gradle/
build/
app/build/
.ruff_cache/
__pycache__/
*.pyc
local.properties
*.iml
.idea/

# ---- local environments
.venv/

# ---- large local-only inputs (fetched by vault-os/scripts, never versioned)
downloads/
reference/

# ---- key material: never in the repository
# The development AVB key is regenerated by vault-os/scripts/generate-development-avb-key.sh;
# only the public half is versioned. Release keys live outside the tree by policy
# (sign-release.sh refuses vault-os/keys/development/*).
vault-os/keys/development/*.pem
!vault-os/keys/development/avb-public.pem
vault-os/keys/release/
*.pk8
*.jks
*.keystore
adbkey
adbkey.pub

# ---- host pairing state and device dumps
paired-signer.json
*.dump.png
vault_dump*.png

# ---- OS / editor / local noise
.DS_Store
.env
.env.*
*.log

# ---- release-gate test fixtures generated locally
.gate-fixture/
