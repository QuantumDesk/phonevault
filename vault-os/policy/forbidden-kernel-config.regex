# Extended regular expressions matched against enabled entries in
# META/kernel_configs.txt. Every non-comment line is release-blocking.

# Wireless and cellular data-plane drivers.
^CONFIG_(BT|BTFM_SLIM|BTFM_SLIM_WCN3990|MSM_BT_POWER)=(y|m)$
^CONFIG_(NFC|NFC_NQ|NFC_NQ_PN81A)=(y|m)$
^CONFIG_(WIRELESS|WIRELESS_EXT|WLAN|QCA_CLD_WLAN)=(y|m)$
^CONFIG_(CNSS_GENL|CNSS_UTILS|GOOGLE_WLAN_MAC|ICNSS|WCNSS_MEM_PRE_ALLOC)=(y|m)$
^CONFIG_(IPA3|IPA_UT|RMNET_DATA|RMNET_DATA_FC|RMNET_IPA3|RNDIS_IPA)=(y|m)$
^CONFIG_MODEMSMEM=(y|m)$
^CONFIG_MSM_PIL_MSS_QDSP6V5=(y|m)$
^CONFIG_MSM_GLINK_(LOOPBACK_SERVER|PKT)=(y|m)$

# Camera, sensor-hub, and removed compute-DSP drivers.
^CONFIG_(CAMERA_FW_UPDATE|MEDIA_CAMERA_SUPPORT|TOUCHSCREEN_HEATMAP|INPUT_VD6281|SENSORS_SSC|SPECTRA_CAMERA)=(y|m)$
^CONFIG_(MEDIA_DIGITAL_TV_SUPPORT|MEDIA_CONTROLLER|MEDIA_ATTACH|MEDIA_TUNER)=(y|m)$
^CONFIG_DVB_(AU8522|AU8522_V4L|TUNER_DIB0070|TUNER_DIB0090)=(y|m)$
^CONFIG_VIDEO_(V4L2_SUBDEV_API|FIXED_MINOR_RANGES)=(y|m)$
^CONFIG_MSM_(VIDC_V4L2|VIDC_GOVERNORS|VIDEOCC_SDM845)=(y|m)$
^CONFIG_(MSM_ADSPRPC|MSM_CDSP_LOADER)=(y|m)$

# USB must remain a peripheral with only configfs and the Android accessory
# function available to the appliance transport. DWC3 itself stays dual-role
# (dev ladder rung 2d-d: a gadget-only kernel never enumerated on USB; the
# appliance gate requires CONFIG_USB_DWC3_DUAL_ROLE=y); the host-only mode is
# forbidden, and the host/source roles are refused in the USB HALs while init
# pins the Type-C port to sink.
^CONFIG_USB_DWC3_HOST=(y|m)$
^CONFIG_USB_DWC3_(OF_SIMPLE|PCI)=(y|m)$
^CONFIG_USB_CONFIGFS_(MASS_STORAGE|F_(AUDIO_SRC|CCID|CDEV|DIAG|GSI|HID|MIDI|MTP|PTP|QDSS))=(y|m)$
^CONFIG_SND_USB_AUDIO_QMI=(y|m)$
