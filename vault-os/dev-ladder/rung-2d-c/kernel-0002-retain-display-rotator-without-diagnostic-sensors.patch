diff --git a/drivers/media/Kconfig b/drivers/media/Kconfig
index 3d1c31e0b452..a44bb13bd11d 100644
--- a/drivers/media/Kconfig
+++ b/drivers/media/Kconfig
@@ -2,6 +2,12 @@
 # Multimedia device configuration
 #
 
+# Hidden fixed-function policy switch. Phone Vault keeps the V4L2 core only
+# for the Qualcomm display rotator while camera capture remains disabled.
+# Touchscreen heatmap and optical-sensor clients use this symbol to stay out.
+config PHONEVAULT_APPLIANCE
+	bool "Phone Vault fixed-function appliance policy"
+
 menuconfig MEDIA_SUPPORT
 	tristate "Multimedia support"
 	depends on HAS_IOMEM
@@ -113,7 +120,8 @@ comment "Multimedia core support"
 config VIDEO_DEV
 	tristate
 	depends on MEDIA_SUPPORT
-	depends on MEDIA_CAMERA_SUPPORT || MEDIA_ANALOG_TV_SUPPORT || MEDIA_RADIO_SUPPORT || MEDIA_SDR_SUPPORT
+	depends on MEDIA_CAMERA_SUPPORT || MEDIA_ANALOG_TV_SUPPORT || MEDIA_RADIO_SUPPORT || MEDIA_SDR_SUPPORT || \
+		PHONEVAULT_APPLIANCE
 	default y
 
 config VIDEO_V4L2_SUBDEV_API
diff --git a/include/linux/input/heatmap.h b/include/linux/input/heatmap.h
index 7e4a328a0a4d..a333b569bb45 100644
--- a/include/linux/input/heatmap.h
+++ b/include/linux/input/heatmap.h
@@ -1,5 +1,7 @@
 /* SPDX-License-Identifier: GPL-2.0 */
 
+#if IS_ENABLED(CONFIG_TOUCHSCREEN_HEATMAP)
+
 #include <media/v4l2-device.h>
 #include <media/v4l2-ioctl.h>
 #include <media/videobuf2-v4l2.h>
@@ -43,3 +45,39 @@ void heatmap_remove(struct v4l2_heatmap *v4l2);
  * read_frame(..) provided by the driver to read the actual data.
  */
-void heatmap_read(struct v4l2_heatmap *v4l2, uint64_t timestamp);
\ No newline at end of file
+void heatmap_read(struct v4l2_heatmap *v4l2, uint64_t timestamp);
+
+#else
+
+#include <linux/types.h>
+#include <linux/videodev2.h>
+
+struct device;
+struct input_dev;
+
+typedef int16_t strength_t;
+
+/*
+ * Keep only the fields used by the panel drivers. No video device, queue, or
+ * raw touch-frame interface exists in a Phone Vault kernel.
+ */
+struct v4l2_heatmap {
+	struct device *parent_dev;
+	struct input_dev *input_dev;
+	struct v4l2_pix_format format;
+	size_t width;
+	size_t height;
+	struct v4l2_fract timeperframe;
+	bool (*read_frame)(struct v4l2_heatmap *v4l2, strength_t *data);
+};
+
+static inline int heatmap_probe(struct v4l2_heatmap *v4l2)
+{
+	return 0;
+}
+
+static inline void heatmap_remove(struct v4l2_heatmap *v4l2) { }
+
+static inline void heatmap_read(struct v4l2_heatmap *v4l2,
+		uint64_t timestamp) { }
+
+#endif
