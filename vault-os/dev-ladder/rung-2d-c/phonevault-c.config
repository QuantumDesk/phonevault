# Phone Vault kernel fragment, slice C: camera, media/video codecs, DVB, sensor hub, touchscreen
# heatmap, compute-DSP loaders. Needs kernel patch 0002 (in this rung dir): it defines
# PHONEVAULT_APPLIANCE, keeps the V4L2 core for the display rotator with camera support off, and
# stubs the heatmap client. Without the patch the kernel fails to link (sde_hw_rot / heatmap.c).
CONFIG_PHONEVAULT_APPLIANCE=y
# CONFIG_CAMERA_FW_UPDATE is not set
# CONFIG_MEDIA_CAMERA_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_CONTROLLER is not set
# CONFIG_MEDIA_ATTACH is not set
# CONFIG_MEDIA_TUNER is not set
# CONFIG_DVB_AU8522 is not set
# CONFIG_DVB_AU8522_V4L is not set
# CONFIG_DVB_TUNER_DIB0070 is not set
# CONFIG_DVB_TUNER_DIB0090 is not set
# CONFIG_VIDEO_V4L2_SUBDEV_API is not set
# CONFIG_VIDEO_FIXED_MINOR_RANGES is not set
# CONFIG_MSM_VIDC_V4L2 is not set
# CONFIG_MSM_VIDC_GOVERNORS is not set
# CONFIG_MSM_VIDEOCC_SDM845 is not set
# CONFIG_TOUCHSCREEN_HEATMAP is not set
# CONFIG_INPUT_VD6281 is not set
# CONFIG_SENSORS_SSC is not set
# CONFIG_SPECTRA_CAMERA is not set
# CONFIG_MSM_ADSPRPC is not set
# CONFIG_MSM_CDSP_LOADER is not set
