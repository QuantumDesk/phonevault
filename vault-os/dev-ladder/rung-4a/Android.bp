android_app_import {
    name: "PhoneVault",
    apk: "PhoneVault.apk",
    presigned: true,
    // Keep APK Signature Scheme v2 intact; Soong must not realign or rewrite
    // this already-verified signer artifact.
    preprocessed: true,
    // Device-owner authority is granted by DevicePolicyManager, not by
    // priv-app placement. Keep the signer in the ordinary system-app domain.
    privileged: false,
    // Android expands inherited product lists after evaluating the leaf
    // product, so Make's -= cannot reliably remove upstream entries. Module
    // overrides are applied to the fully expanded install graph.
    // Rung 1b: the appliance has no setup wizard (first override restored; the rest below
    // stay disabled until their own boot-tested rungs).
    //
    // How removal works here (rung 4, verified against build/make/core on the build host):
    // main.mk drops every module named in an installed module's `overrides` before it expands
    // `required` (product-installed-modules / expand-required-modules), so an override removes a
    // module no matter which inherited makefile listed it. It does NOT help when another
    // *installed* module lists the target in `required`: add-all-target-to-target-required-modules-deps
    // then makes the requirer's installed file depend on the target's, and ninja stages it anyway.
    // So each entry below was checked against the LOCAL_REQUIRED_MODULES of every Soong module
    // (out/soong/Android-vault_crosshatch.mk), and requirers are overridden with their targets
    // (Launcher3QuickStep requires TrebuchetQuickStep; Aperture requires ApertureLensLauncher).
    // Verify on target-files with dev-ladder/check-overrides.sh before flashing.
    overrides: [
        // Rung 1b: no setup wizard.
        "LineageSetupWizard",

        // ---- Rung 4a: user-facing apps nothing in system_server / SystemUI binds at boot ----
        // Launcher. AOSP handheld_system_ext.mk lists Launcher3QuickStep, whose Trebuchet module
        // has required: ["TrebuchetQuickStep"]; Lineage common_mobile.mk lists TrebuchetQuickStep.
        // Both ends are overridden. HOME is then PhoneVault (priority 0) with Settings'
        // FallbackHome (priority -1000, direct-boot only) as the only other candidate.
        "TrebuchetQuickStep",
        "Launcher3QuickStep",
        "TrebuchetOverlay",
        "IconPackCircularLauncherOverlay",
        "IconPackFilledLauncherOverlay",
        "IconPackKaiLauncherOverlay",
        "IconPackRoundedLauncherOverlay",
        "IconPackSamLauncherOverlay",
        "IconPackVictorLauncherOverlay",
        // Camera / media / productivity apps (no camera, no media, no network on the appliance).
        "Aperture",
        "ApertureLensLauncher",
        "AudioFX",
        "Camelot",
        "DeskClock",
        "Etar",
        "ExactCalculator",
        "Gallery2",
        "Glimpse",
        "Jelly",
        "Recorder",
        "Twelve",
        "Updater",
        // Wallpaper / theme / sound pickers, dreams, misc UI.
        "AvatarPicker",
        "Backgrounds",
        "BasicDreams",
        "EasterEgg",
        "HTMLViewer",
        "LiveWallpapersPicker",
        "PhotoTable",
        "SoundPicker",
        "ThemePicker",
        "ThemesStub",
        // Settings satellites and leaf services launched only by explicit user action.
        "AccessibilityMenu",
        "CameraExtensionsProxy",
        "DeviceAsWebcam",
        "DeviceDiagnostics",
        "DownloadProviderUi",
        "EmergencyInfo",
        "SettingsIntelligence",
        "Tag",
    ],
    // DEBUG48: overrides disabled for boot-proving build (restore incrementally with boot tests).
    // This commented list is the release candidate set; entries active above are restored.
