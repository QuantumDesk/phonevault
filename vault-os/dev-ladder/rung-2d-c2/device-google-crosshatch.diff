diff --git a/crosshatch/BoardConfig.mk b/crosshatch/BoardConfig.mk
index 1de0642..bae058c 100644
--- a/crosshatch/BoardConfig.mk
+++ b/crosshatch/BoardConfig.mk
@@ -25,3 +25,6 @@ else
 endif
 
 include device/google/crosshatch/crosshatch/BoardConfigLineage.mk
+
+# Phone Vault branding: prebuilt mono pixel-art boot animation
+TARGET_BOOTANIMATION := vendor/phonevault/branding/bootanimation.zip
--- a/init.hardware.rc
+++ b/init.hardware.rc
@@ -623,15 +623,9 @@
 on property:persist.vendor.sys.ssr.enable_ramdumps=0
     write /sys/module/subsystem_restart/parameters/enable_ramdumps 0
 
-service adsprpcd /vendor/bin/adsprpcd
-   class main
-   user media
-   group media
-
-service cdsprpcd /vendor/bin/cdsprpcd
-   class main
-   user system
-   group system
+# Phone Vault (rung 2d-c2): adsprpcd and cdsprpcd removed. CONFIG_MSM_ADSPRPC is off
+# (kernel slice C), so /dev/adsprpc-smd and /dev/cdsprpc-smd never exist and both daemons
+# could only exit and be restarted by init.
 
 service irsc_util /vendor/bin/irsc_util "/vendor/etc/sec_config"
     class core
@@ -655,10 +649,8 @@
    group system
    capabilities NET_BIND_SERVICE
 
-service cnss-daemon /vendor/bin/cnss-daemon -n -l
-   class late_start
-   user system
-   group system inet wifi
+# Phone Vault (rung 2d-c2): cnss-daemon removed; the WLAN/CNSS drivers are gone since
+# kernel slice A (rung 2d-a).
 
 service loc_launcher /vendor/bin/loc_launcher
     class late_start
@@ -705,12 +697,9 @@
     group root
     task_profiles ServiceCapacityLow
 
-service ppd /vendor/bin/mm-pp-dpps
-    class late_start
-    user graphics
-    group graphics
-    socket pps stream 0660 system system
-    disabled
+# Phone Vault (rung 2d-c2): ppd (mm-pp-dpps, display post-processing driven by the
+# ambient-light sensor) removed with the sensor stack. It crash-looped on 2d-c while the
+# panel worked, so hwcomposer does not depend on it.
 
 service wait_for_strongbox /vendor/bin/hw/wait_for_strongbox
     user root
@@ -718,12 +707,6 @@
     priority -20
     ioprio rt 0
 
-on property:init.svc.vendor.hwcomposer-2-3=stopped
-    stop ppd
-
-on property:init.svc.vendor.hwcomposer-2-3=running
-    start ppd
-
 on property:ro.boot.mode=sota
     setprop ro.boot.sota enabled
 
--- a/device.mk
+++ b/device.mk
@@ -440,12 +440,13 @@
     android.hardware.vibrator-service.crosshatch
 
 #GNSS HAL
+# Phone Vault (rung 2d-c2): the GNSS HAL service + impl are not installed. The GNSS engine
+# lives in the modem (gone since kernel slice B) and the appliance VINTF manifest never
+# declared IGnss, so gnss_service could only fail to register and be restarted.
 PRODUCT_PACKAGES += \
     libgps.utils \
     libgnss \
-    liblocation_api \
-    android.hardware.gnss@1.1-impl-qti \
-    android.hardware.gnss@1.1-service-qti
+    liblocation_api
 
 ENABLE_VENDOR_RIL_SERVICE := true
 
