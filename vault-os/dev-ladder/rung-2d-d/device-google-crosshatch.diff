diff --git a/device.mk b/device.mk
index 651cd6c..3f4513d 100644
--- a/device.mk
+++ b/device.mk
@@ -368,9 +368,11 @@ PRODUCT_PACKAGES += \
     android.hardware.drm-service.clearkey
 
 # NFC and Secure Element packages
+# Phone Vault (rung 2d-c3): the NFC HAL service (vendor.nfc_hal_service) is not installed. The
+# NFC controller driver is gone since kernel slice A and the appliance VINTF manifest never
+# declared INfc, so the service could only fail and be restarted (~80 restarts / 90 s on 2d-c2).
 PRODUCT_PACKAGES += \
     Tag \
-    android.hardware.nfc@1.2-service \
     android.hardware.secure_element@1.1-service-disabled
 
 PRODUCT_PRODUCT_PROPERTIES += \
@@ -408,9 +410,12 @@ PRODUCT_PROPERTY_OVERRIDES += \
     debug.media.transcoding.codec_max_operating_rate_1080P=240 \
     debug.media.transcoding.codec_max_operating_rate_4k=120 \
 
+# Phone Vault (rung 2d-c3): the camera provider service (vendor.camera-provider-2-4) is not
+# installed. The camera drivers are gone since kernel slice C and the appliance VINTF manifest
+# never declared ICameraProvider, so the service crash-looped on 2d-c2. The passthrough impl
+# libraries stay (nothing loads them without the service; removal is a later slice).
 PRODUCT_PACKAGES += \
     android.hardware.camera.provider@2.4-impl \
-    android.hardware.camera.provider@2.4-service_64 \
     camera.device@3.2-impl
 
 PRODUCT_COPY_FILES += \
@@ -440,12 +445,13 @@ PRODUCT_PACKAGES += \
     android.hardware.vibrator-service.crosshatch
 
 #GNSS HAL
+# Phone Vault (rung 2d-c2): the GNSS HAL service + impl are not installed. The GNSS engine
+# lives in the modem (gone since kernel slice B) and the appliance VINTF manifest never
+# declared IGnss, so gnss_service could only fail to register and be restarted.
 PRODUCT_PACKAGES += \
     libgps.utils \
     libgnss \
-    liblocation_api \
-    android.hardware.gnss@1.1-impl-qti \
-    android.hardware.gnss@1.1-service-qti
+    liblocation_api
 
 ENABLE_VENDOR_RIL_SERVICE := true
 
