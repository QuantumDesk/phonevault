# Phone Vault kernel fragment, sub-slice A23: WLAN/CNSS + IPA/RMNET together.
# IPA cannot be dropped alone: the qcacld WLAN driver fails to compile without it (-Werror, 2026-09-13).
# CONFIG_WIRELESS is not set
# CONFIG_WIRELESS_EXT is not set
# CONFIG_WLAN is not set
# CONFIG_QCA_CLD_WLAN is not set
# CONFIG_CNSS_GENL is not set
# CONFIG_CNSS_UTILS is not set
# CONFIG_GOOGLE_WLAN_MAC is not set
# CONFIG_ICNSS is not set
# CONFIG_WCNSS_MEM_PRE_ALLOC is not set
# CONFIG_IPA3 is not set
# CONFIG_IPA_UT is not set
# CONFIG_RMNET_DATA is not set
# CONFIG_RMNET_DATA_FC is not set
# CONFIG_RMNET_IPA3 is not set
# CONFIG_RNDIS_IPA is not set
