# Minimal USB gadget topology for Phone Vault.
# The release default is no active gadget. Android's USB gadget HAL may link
# accessory.gs2 only after an authenticated host initiates AOA negotiation.
# ffs.adb exists solely so userdebug bring-up builds can expose authenticated
# ADB; production user builds never select it.

on early-boot
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/bcdDevice 0x0440
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/accessory.gs2
    mkdir /config/usb_gadget/g1/configs/b.1 0770
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770
    setprop sys.usb.controller "a600000.dwc3"
    write /sys/module/libcomposite/parameters/disable_l1_for_hs "y"

# A release build never creates an ADB endpoint. This trigger exists only for
# authenticated userdebug bring-up and cannot be activated on a user build
# because ro.debuggable is immutable.
on early-boot && property:ro.debuggable=1
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000,no_disconnect=1

on boot
    setprop sys.usb.configfs 2
    # Remain the USB peripheral/sink. Do not enumerate or parse arbitrary USB
    # devices as a host. AOA uses the desktop as host and Phone Vault as UFP.
    write /sys/class/typec/port0/port_type sink

on property:sys.usb.config=none
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    setprop sys.usb.state none
