android_app_import {
    name: "PhoneVault",
    apk: "PhoneVault.apk",
    presigned: true,
    // Keep APK Signature Scheme v2 intact; Soong must not realign or rewrite
    // this already-verified signer artifact.
    preprocessed: true,
    // Device-owner authority is granted by DevicePolicyManager, not by
    // priv-app placement. Keep the signer in the ordinary system-app domain.
    privileged: false,
    // Android expands inherited product lists after evaluating the leaf
    // product, so Make's -= cannot reliably remove upstream entries. Module
    // overrides are applied to the fully expanded install graph.
    // Release removal list = the boot-tested dev ladder (crosshatch rung 4b)
    // plus the release-only entries below it. See vault-os/docs/release-config.md.
    //
    // NEVER override (proven required by the ladder; tests/test_forbidden_policy_coverage.py
    // enforces it): Settings (FallbackHome, confirm-credential, device-admin UI),
    // PackageInstaller (PackageManagerService requires exactly one installer at boot),
    // LatinIME (the only IME; SystemUI's step-up PIN prompt is an ImeAwareEditText),
    // FusedLocation (LocationManagerService requires a direct-boot fused provider),
    // ModuleMetadata (system_server boot loop without it, rung 4b first flash).
    //
    // How removal works (rung 4, verified against build/make/core): main.mk drops every
    // module named in an installed module's `overrides` before it expands `required`, so an
    // override removes a module no matter which inherited makefile listed it. It does NOT
    // help when another *installed* module lists the target in `required`; requirers are
    // overridden with their targets (Launcher3QuickStep -> TrebuchetQuickStep, Aperture ->
    // ApertureLensLauncher, Seedvault -> LocalContactsBackup). The release gate runs
    // dev-ladder/check-overrides.sh release on the target-files before signing.
    overrides: [
        "LineageSetupWizard",

        // ---- Rung 4a: user-facing apps nothing in system_server / SystemUI binds at boot ----
        // Launcher. AOSP handheld_system_ext.mk lists Launcher3QuickStep, whose Trebuchet module
        // has required: ["TrebuchetQuickStep"]; Lineage common_mobile.mk lists TrebuchetQuickStep.
        // Both ends are overridden. HOME is then PhoneVault (priority 0) with Settings'
        // FallbackHome (priority -1000, direct-boot only) as the only other candidate.
        "TrebuchetQuickStep",
        "Launcher3QuickStep",
        "TrebuchetOverlay",
        "IconPackCircularLauncherOverlay",
        "IconPackFilledLauncherOverlay",
        "IconPackKaiLauncherOverlay",
        "IconPackRoundedLauncherOverlay",
        "IconPackSamLauncherOverlay",
        "IconPackVictorLauncherOverlay",
        // Camera / media / productivity apps (no camera, no media, no network on the appliance).
        "Aperture",
        "ApertureLensLauncher",
        "AudioFX",
        "Camelot",
        "DeskClock",
        "Etar",
        "ExactCalculator",
        "Gallery2",
        "Glimpse",
        "Jelly",
        "Recorder",
        "Twelve",
        "Updater",
        // Wallpaper / theme / sound pickers, dreams, misc UI.
        "AvatarPicker",
        "Backgrounds",
        "BasicDreams",
        "EasterEgg",
        "HTMLViewer",
        "LiveWallpapersPicker",
        "PhotoTable",
        "SoundPicker",
        "ThemePicker",
        "ThemesStub",
        // Settings satellites and leaf services launched only by explicit user action.
        "AccessibilityMenu",
        "CameraExtensionsProxy",
        "DeviceAsWebcam",
        "DeviceDiagnostics",
        "DownloadProviderUi",
        "EmergencyInfo",
        "SettingsIntelligence",
        "Tag",

        // ---- Rung 4b: system-side apps (bound by system_server / SystemUI / TeleService on demand,
        // never needed to boot); the device diff also drops the BT / NFC / OMAPI features ----
        // Active Edge: persistent, crash-loops without the squeeze sensors (gone since slice C).
        "ElmyraService",
        "GoogleParts",
        // Telephony *UI* and role-holder apps. TeleService, Telecom, TelephonyProvider,
        // CarrierConfig and the radio/IMS glue stay for the telephony rung (system_server gating).
        "CallLogBackup",
        "CarrierDefaultApp",
        "CellBroadcastLegacyApp",
        "Contacts",
        "Dialer",
        "SimAppDialog",
        "Stk",
        "messaging",
        // Backup: a device owner disables the backup service anyway; app has allowBackup=false.
        "BackupRestoreConfirmation",
        "LocalContactsBackup",
        "LocalTransport",
        "Seedvault",
        "SharedStorageBackup",
        "WallpaperBackup",
        // Printing (PrintManagerService only binds the spooler when a print job is created).
        "BuiltInPrintService",
        "PrintRecommendationService",
        "PrintSpooler",
        // WebView: provider and the android.software.webview feature, so SystemServer does not
        // start WebViewUpdateService at all (nothing on the appliance renders web content).
        "webview",
        "android.software.webview.prebuilt.xml",
        // Files / storage UIs (MediaProvider, MediaProviderLegacy, DownloadProvider and
        // ExternalStorageProvider stay for the media rung).
        "DocumentsUI",
        "DocumentsUIOverlay",
        "MtpService",
        "StorageManager",
        // Lineage extras (the SDK services and LineageSettingsProvider stay).
        "LineageParts",
        "Profiles",
        "QuickAccessWallet",
        // Framework satellites bound only on explicit request (DSU, CDM pairing, credential
        // manager UI, cert install, app-link verification, module metadata, VPN, PAC, captive
        // portal, BT MIDI) and the OMAPI service (its feature goes in the device diff).
        "BluetoothMidiService",
        "CaptivePortalLogin",
        "CertInstaller",
        "CompanionDeviceManager",
        "CredentialManager",
        "DynamicSystemInstallationService",
        // "ModuleMetadata": KEPT — without it ModuleInfoProvider never loads and
        // AppRestrictionController.onSystemReady crashes system_server on every boot.
        "PacProcessor",
        "ProxyHandler",
        "SecureElement",
        "StatementService",
        "VpnDialogs",
        // Content providers nobody on the appliance queries.
        "BookmarkProvider",
        "CalendarProvider",
        "E2eeContactKeysProvider",
        "PartnerBookmarksProvider",
        // Pixel proprietary, non-radio (FeliCa, camera services, AiAi / ambient / hotword,
        // hardware-info, Qualcomm secure-UI). Radio/carrier blobs go with the telephony rung.
        "AmbientSensePrebuilt",
        "DeviceIntelligenceNetworkPrebuilt",
        "DevicePersonalizationPrebuiltPixel3",
        "HardwareInfo",
        "HotwordEnrollmentOKGoogleWCD9340",
        "HotwordEnrollmentXGoogleWCD9340",
        "MobileFeliCaClient",
        "MobileFeliCaMenuMainApp",
        "MobileFeliCaSettingApp",
        "MobileFeliCaWebPlugin",
        "MobileFeliCaWebPluginBoot",
        "PixelCameraServicesCrosshatch",
        "com.qualcomm.qti.services.secureui",

        // ---- Release-only: ahead of the boot-tested ladder (rungs 4c+: telephony/radio,
        // network stack, media providers, ManagedProvisioning, APEXes, HAL services and
        // native tools). Each is coupled to the release appliance/device patches; none has
        // been boot-tested in a ladder rung yet, so a release build that boots is still
        // required before shipping (vault-os/docs/release-config.md). ----
        "BlockedNumberProvider",
        "Browser2",
        "CarrierConfig",
        "CneApp",
        "ConnectivityOverlay",
        "DownloadProvider",
        "ExternalStorageProvider",
        "IPACM_cfg.xml",
        "IWlanService",
        "ImsServiceEntitlement",
        "ManagedProvisioning",
        "MmsService",
        "Music",
        "modem_svc",
        "MusicFX",
        "NetworkStack",
        "NetworkStackNext",
        "NetworkStackOverlay",
        "NfcNci",
        "ONS",
        "OsuLogin",
        "QtiTelephonyService",
        "RadioConfigLib",
        "RilConfigService",
        "TeleService",
        "Telecom",
        "TelephonyProvider",
        "TelephonyProviderHsum",
        "Tethering",
        "TrebuchetQuickStepGo",
        "WallpaperPicker2",
        "WifiOverlay",
        "android.hardware.bluetooth@1.0-impl-qti",
        "android.hardware.bluetooth@1.0-service-qti",
        "android.hardware.bluetooth.audio@2.0-impl",
        "android.hardware.camera.provider@2.4-impl",
        "android.hardware.camera.provider@2.4-service_64",
        "android.hardware.contexthub@1.2-service.generic",
        "android.hardware.drm-service.clearkey",
        "android.hardware.drm@1.3-service.widevine",
        "android.hardware.drm@1.3.vendor",
        "android.hardware.dumpstate@1.1-service.crosshatch",
        "android.hardware.gnss@1.1-impl-qti",
        "android.hardware.gnss@1.1-service-qti",
        "android.hardware.neuralnetworks@1.0-service-paintbox",
        "android.hardware.neuralnetworks@1.3-service-qti",
        "android.hardware.nfc@1.2-service",
        "android.hardware.rebootescrow-service.citadel",
        "android.hardware.secure_element@1.1-service-disabled",
        "android.hardware.sensors@2.0-impl",
        "android.hardware.sensors@2.0-service",
        "android.hardware.soundtrigger@2.2-impl",
        "android.hardware.wifi-service",
        "audio.bluetooth.default",
        "bash",
        "bugreport",
        "bugreport_procdump",
        "bugreportz",
        "camera.device@3.2-impl",
        "camera.sdm845",
        "cameraserver",
        "chre_daemon_msm",
        "cdsprpcd",
        "cnd",
        "cnss-daemon",
        "cnss_diag",
        "com.android.adservices",
        "com.android.appsearch",
        "com.android.cellbroadcast",
        "com.android.devicelock",
        "com.android.extservices",
        "com.android.healthfitness",
        "com.android.location.provider",
        "com.android.media.swcodec",
        "com.android.neuralnetworks",
        "com.android.nfcservices",
        "com.android.ondevicepersonalization",
        // Remote Key Provisioning is a privileged network client packaged as
        // an updatable APEX. The appliance uses local StrongBox keys and must
        // never contact the Android provisioning backend.
        "com.android.rkpd",
        // DNS resolution is a standalone network APEX and is not part of the
        // boot classpath. Network services never start on the appliance.
        "com.android.resolv",
        "com.android.scheduling",
        "com.android.uwb",
        "com.android.virt",
        "com.android.webview.bootstrap",
        "com.google.android.camera.experimental2018",
        "com.google.android.camera.extensions",
        "curl",
        "dnsmasq",
        "dmesgd",
        "dumpstate",
        "easelmanagerd",
        "google-ril",
        "grilservice",
        "hostapd",
        "htop",
        "heapprofd",
        "heapprofd_client",
        "ims",
        "ims_rtp_daemon",
        "imsdatadaemon",
        "imsqmidaemon",
        "imsrcsd",
        "ip",
        "ipacm",
        "iptables",
        "incident",
        "incident-helper-cmd",
        "incident_report",
        "incidentd",
        "incident_helper",
        "irsc_util",
        "libgnss",
        "libgps.utils",
        "liblocation_api",
        "loc_launcher",
        "lowi-server",
        "mdnsd",
        "nano",
        "ndc",
        "netd",
        "netmgrd",
        "pd-mapper",
        "perfetto",
        "perfetto-extras",
        "arping",
        "iw",
        "ping",
        "tcpdump",
        "ping6",
        "qcrild",
        "qcrilhook",
        "qcrilmsgtunnel",
        "ramoops",
        "rild",
        "rsync",
        "rmt_storage",
        "scp",
        "sftp",
        "ssh",
        "ssh-keygen",
        "ss",
        "sshd",
        "sshd_config",
        "sscrpcd",
        "ssr_diag",
        "ssr_setup",
        "start-ssh",
        "subsystem_ramdump",
        "tc",
        "traced",
        "traced_probes",
        "time_daemon",
        "tftp_server",
        "uceShimService",
        "uimremoteclient",
        "uimremoteclientlibrary",
        "uimremoteserver",
        "uimremoteserverlibrary",
        "uimservicelibrary",
        "vendor.google.wireless_charger@1.0",
        "vendor.google.wireless_charger@1.1",
        "vendor.google.wireless_charger@1.2",
        "vendor.google.wireless_charger@1.3",
        "vendor.google.wireless_charger@1.3-service-vendor",
        "vendor.google.wireless_charger@1.3-service-vendor.xml",
        "vendor.google_paintbox@1.0",
        "vendor.qti.media.c2@1.0-service",
        "vim",
        "wifi.rc",
        "wificond",
        "wpa_supplicant",
        "wpa_supplicant.conf",
        "xtra-daemon",
        "sensors.qti",
        "sensors.ssc",
    ],
    dex_preopt: {
        enabled: true,
    },
}
