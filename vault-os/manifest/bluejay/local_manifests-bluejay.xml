<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phone Vault: Pixel 6a (bluejay, gs101) on LineageOS 24.0 (Android 17).
  Goes into <tree>/.repo/local_manifests/ of a SEPARATE tree initialised with
    repo init -u https://github.com/LineageOS/android.git -b lineage-24.0
         (plus: git-lfs, depth 1, no clone bundle, groups default,-darwin,-notdefault)
  These are exactly the projects `breakfast bluejay` would add to roomservice.xml
  (the device tree's lineage.dependencies) plus the TheMuppets blobs listed in
  TheMuppets/manifests muppets.xml for lineage-24.0.
  Never add this to the crosshatch lineage-22.2 tree: see docs/port-bluejay.md.
  vendor/google/bluejay carries blobs and firmware from CP2A.260705.006, the build
  whose bootloader (bluejay-17.0-15199431) and radio the owner's phone already runs.
  The kernel is built in its own workspace (LineageOS/android_kernel_google_gs-6.1_manifest,
  branch lineage-24.0) and its dist output is copied into device/google/bluejay-kernels/6.1.
  Pin to SHAs (generate-pinned-manifest) once the first bluejay rung boots.
-->
<manifest>
  <project path="device/google/bluejay" remote="github" name="LineageOS/android_device_google_bluejay" />
  <project path="device/google/gs101" remote="github" name="LineageOS/android_device_google_gs101" />
  <project path="device/google/bluejay-kernels" remote="github" name="LineageOS/android_device_google_bluejay-kernels" />
  <project path="vendor/google/bluejay" remote="github" name="TheMuppets/proprietary_vendor_google_bluejay" clone-depth="1" />
</manifest>
