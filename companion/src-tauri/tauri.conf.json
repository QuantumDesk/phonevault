{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phone Vault Companion",
  "version": "0.1.0",
  "identifier": "org.phonevault.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Phone Vault Companion",
        "width": 560,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost wss://relay.walletconnect.org https://verify.walletconnect.org https://verify.walletconnect.com",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost wss://relay.walletconnect.org https://verify.walletconnect.org https://verify.walletconnect.com ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2026 Phone Vault contributors. Apache-2.0.",
    "category": "Utility",
    "shortDescription": "Phone Vault Companion",
    "longDescription": "Pairs with a Phone Vault signer over USB, quotes transactions from an Ethereum node, and broadcasts only what you approved on the phone.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../../tools/backup-card/out/phone-vault-backup-card-a4-compact25.pdf": "backup-card/phone-vault-backup-card-a4-compact25.pdf",
      "../../tools/backup-card/out/phone-vault-backup-card-a4-standard29.pdf": "backup-card/phone-vault-backup-card-a4-standard29.pdf",
      "../../tools/backup-card/out/phone-vault-backup-card-letter-compact25.pdf": "backup-card/phone-vault-backup-card-letter-compact25.pdf",
      "../../tools/backup-card/out/phone-vault-backup-card-letter-standard29.pdf": "backup-card/phone-vault-backup-card-letter-standard29.pdf"
    }
  }
}
